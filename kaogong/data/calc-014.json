    {"type": "pure", "level": "基础", "topic": "首数直除", "stem": "计算 4726 ÷ 123 的值（保留一位小数）。", "data": "", "options": ["30.4", "38.4", "42.8", "48.4"], "answer": ["B"], "method": "首数直除：123×38＝4674，余 52；52÷123≈0.4，故 4726÷123≈38.4。", "explain": "123×38＝4674，与 4726 相差 52，52/123 首位是 4，所以商≈38.4。", "tip": "先定商的位数（四位数÷三位数≈两位数），别把商写成 384。", "hard": "选项 30.4、42.8 是位数或估位错误，首数算对即可排除。"},
    {"type": "pure", "level": "基础", "topic": "特征分数互换", "stem": "计算 37.5% × 2400 ＝（　）", "data": "", "options": ["800", "900", "960", "1080"], "answer": ["B"], "method": "37.5%＝3/8；2400×3/8＝2400÷8×3＝300×3＝900。", "explain": "把 37.5% 化成 3/8：2400÷8＝300，再×3＝900。", "tip": "37.5%＝3/8（不是 3/7），先化分数再算。", "hard": "把 37.5% 记成 0.357 会滑向干扰项。"},
    {"type": "pure", "level": "基础", "topic": "特征分数互换", "stem": "计算 12.5% × 880 ＝（　）", "data": "", "options": ["99", "110", "121", "88"], "answer": ["B"], "method": "12.5%＝1/8；880÷8＝110。", "explain": "12.5% 就是 1/8，880 除以 8 得 110。", "tip": "12.5%、6.25%、25%、62.5% 都是常用特征分数，先记牢。", "hard": "别把 12.5% 老老实实列竖式乘，浪费时间。"},
    {"type": "pure", "level": "基础", "topic": "特征分数互换·分子分母同乘", "stem": "计算 2750 ÷ 0.125 ＝（　）", "data": "", "options": ["2200", "22000", "220000", "1100"], "answer": ["B"], "method": "0.125＝1/8；除以 1/8 等于乘 8：2750×8＝22000。", "explain": "2750÷0.125＝2750×8＝22000。", "tip": "『除以 0.125 等于乘 8』，反过来『乘 0.125 等于除以 8』。", "hard": "小数点位数最容易错，先想清楚是乘 8 还是除以 8。"},
    {"type": "pure", "level": "进阶", "topic": "分子分母同除·约分", "stem": "计算 (3.15 × 0.4) ÷ 0.9 ＝（　）", "data": "", "options": ["1.2", "1.4", "1.6", "0.7"], "answer": ["B"], "method": "先算分子 3.15×0.4＝1.26；再 1.26÷0.9＝12.6÷9＝1.4。", "explain": "分子分母同乘 10：12.6÷9＝1.4。", "tip": "除以 0.9 约等于乘 1.1，可先估 1.26×1.1≈1.39。", "hard": "把 0.9 当 1 会得 1.26，正好落在干扰项附近。"},
    {"type": "pure", "level": "进阶", "topic": "比大小·化同法", "stem": "下列分数中，数值最大的是（　）", "data": "", "options": ["5/13", "7/18", "3/8", "9/23"], "answer": ["D"], "method": "交叉相乘逐一比较：5/13 与 7/18 → 5×18=90＜7×13=91，7/18 大；7/18 与 9/23 → 7×23=161＜9×18=162，9/23 更大。", "explain": "5/13≈0.385、7/18≈0.389、3/8≈0.375、9/23≈0.391，最大为 9/23。", "tip": "分子分母都不同时，交叉相乘比大小最快。", "hard": "几数只差千分之几，必须动笔交叉相乘，光靠估会滑向干扰项。"},
    {"type": "pure", "level": "进阶", "topic": "比大小·差分法", "stem": "用差分法比较，下列分数中数值最大的是（　）", "data": "", "options": ["47/123", "53/139", "45/121", "51/137"], "answer": ["A"], "method": "差分法：47/123 与 53/139，差分数＝(53−47)/(139−123)＝6/16＝0.375，小于小分数 47/123≈0.382，故大分数 53/139＜47/123；同法比较其余，47/123 最大。", "explain": "各值：47/123≈0.3821、53/139≈0.3813、45/121≈0.3719、51/137≈0.3723，最大为 47/123。", "tip": "差分数＞小分数 → 大分数＞小分数；差分数＜小分数 → 大分数＜小分数。", "hard": "四个分数只差千分之几，必须用差分法，硬算会超时。"},
    {"type": "pure", "level": "进阶", "topic": "估算·首数直除", "stem": "估算 198.7 ÷ 4.03 的值，最接近（　）", "data": "", "options": ["49.3", "45.0", "53.5", "39.5"], "answer": ["A"], "method": "把 4.03 看成 4：198.7÷4＝49.7；除数略大，结果略小于 49.7，取 49.3。", "explain": "198.7÷4≈49.7，实际除数 4.03 略大于 4，商略小，约 49.3。", "tip": "估算时先凑整，再按偏差方向微调。", "hard": "选项间距较大，估到 49 附近即可锁定答案。"},
    {"type": "pure", "level": "仿真", "topic": "多步运算·估算", "stem": "计算 (2.35 × 108) ÷ 3.2 ≈ （　）", "data": "", "options": ["79.3", "72.5", "85.1", "66.2"], "answer": ["A"], "method": "先算分子 2.35×108＝253.8；再首数直除：3.2×79＝252.8，余 1，故≈79.3。", "explain": "253.8÷3.2＝79.3。", "tip": "两步题先算整块再除，别中途取整丢精度。", "hard": "把 2.35×108 算成 253.9 也无妨，仍在 A 的范围。"},
    {"type": "pure", "level": "仿真", "topic": "估算·百分数拆解", "stem": "估算 6234 × 1.187 ≈ （　）", "data": "", "options": ["7400", "7100", "7800", "8200"], "answer": ["A"], "method": "拆成 6234×(1＋0.187)：6234＋6234×0.187≈6234＋1166＝7400。", "explain": "6234×0.187≈6234×0.2−6234×0.013≈1246.8−81≈1166，加回 6234 得 7400。", "tip": "把百分数拆成『整齐数±零头』，算得又快又稳。", "hard": "0.187 拆成 0.2−0.013，避免直接乘的大误差。"},
    {"type": "pure", "level": "进阶", "topic": "百分数加减", "stem": "计算 45.6% ＋ 18.9% − 12.3% ＝ （　）", "data": "", "options": ["52.2%", "51.2%", "53.2%", "50.2%"], "answer": ["A"], "method": "先加后减：45.6＋18.9＝64.5，64.5−12.3＝52.2（%）。", "explain": "45.6%＋18.9%＝64.5%，再减 12.3% 得 52.2%。", "tip": "整数部分与小数部分分开算，避免进位错误。", "hard": "三个数连加带减，注意 45.6＋18.9 的进位。"},
    {"type": "pure", "level": "基础", "topic": "平均数·估算", "stem": "估算 3945.6 ÷ 523.4 的值，最接近（　）", "data": "", "options": ["7.5", "6.8", "8.3", "5.9"], "answer": ["A"], "method": "523.4×7＝3663.8，余 3945.6−3663.8＝281.8；281.8÷523.4≈0.54，故≈7.54≈7.5。", "explain": "商在 7 与 8 之间且偏向 7.5，选 7.5。", "tip": "先试乘整数部分，再用余数定小数位。", "hard": "选项 6.8 与 8.3 是整数部分估错，先定 x.5 附近。"},
    {"type": "applied", "level": "基础", "topic": "增长率", "stem": "2023年该市地区生产总值同比增长率约为（　）", "data": "【材料】某市2023年地区生产总值1234.5亿元，2022年为1102.3亿元。", "options": ["10.2%", "12.0%", "13.5%", "8.7%"], "answer": ["B"], "method": "增长率＝(现期−基期)÷基期＝(1234.5−1102.3)÷1102.3＝132.2÷1102.3。", "explain": "132.2÷1102.3≈0.120，即约 12.0%。", "tip": "增长率分母是『基期量』，别拿现期量当分母。", "hard": "现期−基期只差 132.2，除以 1102 只有 12% 左右，别被绝对值误导。"},
    {"type": "applied", "level": "进阶", "topic": "增长量·百化分", "stem": "2023年该产品产量比上年增长约多少万吨（　）", "data": "【材料】2023年某产品产量2456.8万吨，同比增长12.5%。", "options": ["273.0", "307.1", "2183.8", "245.7"], "answer": ["A"], "method": "12.5%＝1/8，属『百化分』：增长量＝现期量÷(n＋1)＝2456.8÷9≈273.0（万吨）。", "explain": "2456.8÷9≈273.0 万吨。", "tip": "r＝1/n 时增长量＝现期÷(n＋1)；12.5% 就除以 9。", "hard": "干扰项 307.1＝现期×12.5%（忘除分母）最易误选。"},
    {"type": "applied", "level": "进阶", "topic": "增长量·化分数", "stem": "2023年该市社会消费品零售总额比上年增长约多少亿元（　）", "data": "【材料】2023年某市社会消费品零售总额8600.0亿元，同比增长24%。", "options": ["1664.5", "2064.0", "6935.5", "1720.0"], "answer": ["A"], "method": "24%＝6/25，增长量＝现期量×6/(25＋6)＝8600×6/31≈1664.5（亿元）。", "explain": "8600×6÷31＝51600÷31≈1664.5 亿元。", "tip": "增长量＝现期×r/(1＋r)；把 r 化成 6/25 更快。", "hard": "干扰项 2064.0＝8600×24%（忘除 1＋r），6935.5 是被错当成基期量。"},
    {"type": "applied", "level": "进阶", "topic": "基期量·估算", "stem": "2022年该市快递业务收入约为（　）", "data": "【材料】2023年某市快递业务收入128.6亿元，同比增长7.3%。", "options": ["119.9", "138.0", "121.0", "117.5"], "answer": ["A"], "method": "基期量＝现期量÷(1＋r)＝128.6÷1.073。", "explain": "1.073×119.9≈128.6，故约 119.9 亿元。", "tip": "求基期量是除法，分母是 1＋增长率。", "hard": "干扰项 138.0＝128.6×1.073（把乘法当除法用）。"},
    {"type": "applied", "level": "仿真", "topic": "两期比重差", "stem": "2023年该市第三产业增加值占地区生产总值的比重，与2022年相比约（　）", "data": "【材料】某市2023年第三产业增加值3560.2亿元、地区生产总值8520.5亿元；2022年第三产业增加值3210.4亿元、地区生产总值7920.3亿元。", "options": ["上升1.3个百分点", "下降1.3个百分点", "上升4.6个百分点", "上升0.3个百分点"], "answer": ["A"], "method": "2023年比重＝3560.2/8520.5≈41.8%；2022年比重＝3210.4/7920.3≈40.5%；差≈＋1.3 个百分点。", "explain": "41.8%−40.5%＝1.3 个百分点，比重上升。", "tip": "比重差用『百分点』，先分别算两期比重再相减。", "hard": "干扰项 4.6 是分式本身算错（把分母看错）得出的。"},
    {"type": "applied", "level": "仿真", "topic": "间隔增长率", "stem": "2023年该地区旅客周转量比2022年约增长（　）", "data": "【材料】某地区旅客周转量：2023年比2021年增长27.2%，2022年比2021年增长8.6%。", "options": ["17.1%", "18.6%", "16.0%", "19.5%"], "answer": ["A"], "method": "设2023年比2022年增长 r，则 (1＋8.6%)(1＋r)＝1＋27.2%，故 1＋r＝1.272÷1.086≈1.171。", "explain": "1.272÷1.086≈1.171，r≈17.1%。", "tip": "间隔增长率用两期增长率相除还原，别直接相减。", "hard": "干扰项 18.6%＝27.2%−8.6%（直接相减的错算）。"},
    {"type": "applied", "level": "仿真", "topic": "年均增长率·开方估算", "stem": "2018—2023年该市地区生产总值年均增长率约为（　）", "data": "【材料】某市地区生产总值2018年5620亿元、2023年8215亿元。", "options": ["7.9%", "9.2%", "6.5%", "10.4%"], "answer": ["A"], "method": "年均增长率＝(末年/初年)^(1/n)−1，n＝5；8215/5620≈1.462，(1.462)^0.2≈1.079。", "explain": "1.462 开 5 次方约 1.079，故年均增长约 7.9%。", "tip": "年均增长率是开方，不是总增长率÷年数。", "hard": "干扰项 9.2%≈(1.462−1)/5（总增长率除年数，错算）。"},
    {"type": "applied", "level": "仿真", "topic": "增长量·下降型百化分", "stem": "2023年该市新能源汽车保有量比上年减少约多少万辆（　）", "data": "【材料】2023年某市新能源汽车保有量38.6万辆，同比下降12.5%。", "options": ["5.5", "4.8", "6.3", "3.5"], "answer": ["A"], "method": "下降型：12.5%＝1/8，减少量＝现期量÷(n−1)＝38.6÷7≈5.5（万辆）。", "explain": "减少量＝基期−现期＝38.6/(1−12.5%)×12.5%＝38.6÷7≈5.5 万辆。", "tip": "下降时分母用 1−r；r＝1/n 时减少量＝现期÷(n−1)。", "hard": "干扰项 4.8＝38.6×12.5%（忘除以 1−r 的错算）。"}
  ]
