  "quotes": [
   {
    "en": "The miracle isn't that I finished. The miracle is that I had the courage to start.",
    "cn": "奇迹不在于我跑完了，而在于我有勇气起跑。",
    "who": "约翰·宾汉姆（John Bingham）"
   },
   {
    "en": "It is not the mountain we conquer, but ourselves.",
    "cn": "我们征服的不是高山，而是我们自己。",
    "who": "埃德蒙·希拉里（Edmund Hillary）"
   }
  ]
