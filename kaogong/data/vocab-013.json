  "quotes": [
   {
    "en": "A journey of a thousand miles begins with a single step.",
    "cn": "千里之行，始于足下。",
    "who": "老子（Lao Tzu）"
   },
   {
    "en": "Motivation is what gets you started. Habit is what keeps you going.",
    "cn": "动机让你起步，习惯让你坚持。",
